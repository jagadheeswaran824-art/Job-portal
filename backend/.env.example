# ================================================
# Job Portal — Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Server
PORT=5000
APP_ENV=development

# ── Database (MySQL) ─────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_portal
DB_USER=root
DB_PASSWORD=
# TLS is always enabled for the Layerbase connection.

# ── Authentication ───────────────────────────────
# REQUIRED: Change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret-key

# ── CORS ─────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ALLOWED_ORIGINS=*

# ── File Storage ─────────────────────────────────
STORAGE_PATH=storage
MAX_FILE_SIZE=5242880

# ── AI Intelligence Service (Optional - built-in semantic NLP fallback active) ──
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# AI_MODEL=gemini-1.5-flash

