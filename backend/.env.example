# ================================================
# Job Portal — Environment Configuration
# Copy this file to .env and fill in your values
# ================================================

# Server
PORT=5000
APP_ENV=development

# ── Database (MySQL) ─────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=job_portal
DB_USERNAME=root
DB_PASSWORD=
# Set to REQUIRED for cloud databases (PlanetScale, Railway, etc.)
DB_SSL_MODE=

# ── Authentication ───────────────────────────────
# REQUIRED: Change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret-key

# ── CORS ─────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ALLOWED_ORIGINS=*

# ── File Storage ─────────────────────────────────
STORAGE_PATH=storage
MAX_FILE_SIZE=5242880
