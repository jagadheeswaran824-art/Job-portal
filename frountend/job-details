        .match-item::before {
            content: "✓";
            color: #10b981;
            font-weight: bold;
            margin-right: 8px;
        }

        /* ================= OVERVIEW ================= */

        .overview-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .overview-item {
            padding: 16px;
            background: #f8fafc;
            border-radius: 12px;
        }

        .overview-item small {
