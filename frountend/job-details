        .ai-content {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .match-score {
            width: 105px;
            height: 105px;

            border-radius: 50%;

            background: #ffffff;
            border: 8px solid #c7d2fe;

            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;

            flex-shrink: 0;
        }

        .match-score strong {
            color: #4f46e5;
            font-size: 25px;
        }

        .match-score span {
            color: #64748b;
            font-size: 11px;
        }

        .match-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
