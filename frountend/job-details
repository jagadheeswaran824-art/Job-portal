        }

        .breadcrumb {
            margin-bottom: 28px;
            font-size: 13px;
            color: #64748b;
        }

        .breadcrumb a {
            color: #6366f1;
        }

        .job-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 25px;
        }

        .job-info {
            display: flex;
            gap: 20px;
        }

        .company-logo {
            width: 75px;
            height: 75px;

            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 18px;

            display: flex;
            align-items: center;
